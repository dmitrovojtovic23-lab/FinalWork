<Window x:Class="DownloaderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloader — Практичне завдання №1"
        Height="760" Width="1100"
        Background="#121212"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="10" Padding="12" Background="#1F1F1F">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                <TextBlock Text="Downloader" Foreground="White" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="  —  практичне завдання №1" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" CornerRadius="8" Padding="12" Margin="0,10,0,10" Background="#1C1C1C">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBox x:Name="UrlTextBox" Width="640" Height="34" Background="#262626" Foreground="White" 
                             Padding="6" VerticalContentAlignment="Center" FontSize="13" />
                    <Button Content="Вставити" Width="90" Height="34" Margin="8,0,0,0" Click="BtnPaste_Click"/>
                    <Button Content="Додати" Width="110" Height="34" Margin="8,0,0,0" Background="#2E7D32" Foreground="White" Click="BtnAdd_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="TagsTextBox" Width="280" Height="30" Background="#262626" Foreground="White" Padding="6" VerticalContentAlignment="Center"/>
                    <TextBlock Text="   Папка:" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="DestinationTextBox" Width="420" Height="30" Margin="8,0,0,0" IsReadOnly="True" Background="#262626" Foreground="White" Padding="6"/>
                    <Button Content="Вибрати..." Width="100" Height="30" Margin="8,0,0,0" Click="BtnSelectFolder_Click"/>
                    <TextBlock Text="   Макс паралельних:" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="MaxParallelTextBox" Width="50" Height="26" Text="3" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" CornerRadius="8" Padding="8" Background="#151515">
            <DataGrid x:Name="DownloadsGrid" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Downloads}" RowHeight="44"
                      GridLinesVisibility="None" Background="#151515" Foreground="White" HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="220"/>
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*"/>
                    <DataGridTextColumn Header="Папка" Binding="{Binding Destination}" Width="2*"/>
                    <DataGridTextColumn Header="Теги" Binding="{Binding Tags}" Width="120"/>
                    <DataGridTemplateColumn Header="Прогрес" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="12"/>
                                    <TextBlock Text="{Binding StatusWithSpeed}" FontSize="11" Foreground="#CFCFCF"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Дії" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Старт" Width="56" Margin="2" Click="BtnStart_Click"/>
                                    <Button Content="Пауза" Width="60" Margin="2" Click="BtnPause_Click"/>
                                    <Button Content="Відновити" Width="78" Margin="2" Click="BtnResume_Click"/>
                                    <Button Content="Видалити" Width="70" Margin="2" Click="BtnDelete_Click"/>
                                    <Button Content="Відкрити" Width="70" Margin="2" Click="BtnOpenFile_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock Text="Фільтр по тегу:" Foreground="#BFBFBF" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="FilterTagTextBox" Width="200" Height="26" Background="#262626" Foreground="White" Padding="4"/>
            <Button Content="Застосувати" Width="90" Margin="8,0,0,0" Click="BtnApplyFilter_Click"/>
            <Button Content="Скинути" Width="90" Margin="8,0,0,0" Click="BtnResetFilter_Click"/>
            <Button Content="Очистити завершені" Width="150" Margin="18,0,0,0" Click="BtnClearCompleted_Click"/>
            <TextBlock x:Name="StatsTextBlock" Foreground="#BFBFBF" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
